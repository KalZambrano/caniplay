# Backend
# Base URL of the RigScan API (Cloudflare Worker). Leave empty while developing
# without the backend repo — the app falls back to local mock data automatically.
VITE_API_BASE_URL=

# Force the app to use local mock game data instead of calling the backend.
# Useful for frontend-only development before the backend repo exists,
# or for demos/offline work. "true" | "false"
VITE_USE_MOCK_DATA=true
